# Creed Tech - Environment Configuration Template
# Copy this file to .env and configure for your local/production environment

APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:3000

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=creed_tech

# Session & Security
SESSION_COOKIE_NAME=CREED_ADMIN_SESSID
SESSION_LIFETIME=86400

# News & External Feed Configuration
NEWS_CACHE_TTL=900
ENABLE_AUTO_IMPORT=true
